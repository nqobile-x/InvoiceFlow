# InvoiceFlow Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# ── Email (SendGrid recommended) ──────────────────────────────────────
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=SG.your_sendgrid_api_key_here
MAIL_FROM=invoices@yourdomain.com

# ── PayFast (SA Payment Gateway) ──────────────────────────────────────
# Get these from https://www.payfast.co.za/registration/
# Use sandbox credentials for testing: https://sandbox.payfast.co.za
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=jt7NOE43FZPn
PAYFAST_SANDBOX=true

# ── Database ──────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/invoiceflow
DB_USERNAME=invoiceflow
DB_PASSWORD=your_strong_db_password_here

# ── JWT ───────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=your_256_bit_base64_encoded_secret_here
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# ── App URLs ──────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000

# ── File Storage ──────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
