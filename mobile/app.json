{
  "expo": {
    "name": "InvoiceFlow",
    "slug": "invoiceflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.za.invoiceflow"
    },
    "android": {
      "package": "co.za.invoiceflow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "scheme": "invoiceflow",
    "extra": {
      "apiUrl": "http://192.168.0.249:8080/api/v1",
      "router": {},
      "eas": {
        "projectId": "9793529e-e778-41be-8580-ced37e5ee3e2"
      }
    },
    "owner": "nqobile025s-team"
  }
}
