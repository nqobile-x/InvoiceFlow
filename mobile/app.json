{
  "expo": {
    "name": "InvoiceFlow",
    "slug": "invoiceflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.za.invoiceflow"
    },
    "android": {
      "package": "co.za.invoiceflow",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow InvoiceFlow to access your camera."
        }
      ],
      "expo-asset"
    ],
    "scheme": "invoiceflow",
    "extra": {
      "apiUrl": "http://192.168.0.249:8080/api/v1"
    }
  }
}
