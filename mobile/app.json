{
  "expo": {
    "name": "InvoiceFlow",
    "slug": "invoiceflow",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.za.invoiceflow"
    },
    "android": {
      "package": "co.za.invoiceflow",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0A1628"
      },
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6F1",
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 180,
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0A1628"
          }
        }
      ]
    ],
    "scheme": "invoiceflow",
    "extra": {
      "apiUrl": "https://invoiceflow-api-dwy4.onrender.com/api/v1",
      "router": {},
      "eas": {
        "projectId": "9793529e-e778-41be-8580-ced37e5ee3e2"
      }
    },
    "owner": "nqobile025s-team"
  }
}
